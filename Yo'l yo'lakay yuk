  async function autoDetectFirebase() {
    if (config.firebaseUrl) {
      await syncFromFirebase();
      return;
    }
    const candidates = [
      DEFAULT_FIREBASE_URL,
      "https://yolakay-yuk-default-rtdb.firebaseio.com"
    ];
    for (const url of candidates) {
      try {
        const res = await fetch(`${url}/.json`);
        if (res.ok) {
          config.firebaseUrl = url;
          localStorage.setItem(KEYS.CFG, JSON.stringify(config));
          await syncFromFirebase();
          return;
        }
      } catch (e) {}
    }
    setLiveStatus(false);
  }

  async function syncFromFirebase() {
    if (!config.firebaseUrl) {
      setLiveStatus(false);
      renderLoads();
      return;
    }
    const base = config.firebaseUrl.replace(/\/+$/, "");
    try {
      // Fetch public nodes ONLY (do NOT fetch /load_contacts globally!)
      const [loadsRes, usersRes, topupsRes, settingsRes] = await Promise.all([
        fetch(`${base}/loads.json`),
        fetch(`${base}/users.json`),
        fetch(`${base}/topups.json`),
        fetch(`${base}/settings.json`)
      ]);

      if (!loadsRes.ok) throw new Error("DB error");
      setLiveStatus(true);

      const loadsData = await loadsRes.json();
      if (loadsData) {
        loadsList = Object.values(loadsData).sort((a, b) => (b.createdAt || 0) - (a.createdAt || 0));
        localStorage.setItem(KEYS.LOADS, JSON.stringify(loadsList));
      }

      const usersData = usersRes.ok ? await usersRes.json() : null;
      if (usersData) {
        usersMap = usersData;
        localStorage.setItem(KEYS.USERS, JSON.stringify(usersMap));

        if (userProfile) {
          const pKey = phoneToKey(userProfile.phone);
          const remoteMe = usersMap[pKey];
          if (remoteMe) {
            // REAL-TIME SINGLE-DEVICE CHECK: Kick out immediately if another device took the session!
            if (
              (remoteMe.boundDeviceId && remoteMe.boundDeviceId !== LOCAL_DEVICE_ID) ||
              (remoteMe.activeSessionId && localSessionId && remoteMe.activeSessionId !== localSessionId)
            ) {
              userProfile = null;
              localSessionId = "";
              revealedLoadIds = {};
              localStorage.removeItem(KEYS.USER);
              localStorage.removeItem(KEYS.SESSION_ID);
              document.getElementById("userRoleBar").style.display = "none";
              showAuthScreen(
                `🔒 Ushbu akkauntga boshqa qurilmadan (${remoteMe.boundDeviceLabel || "yangi qurilma"}) kirildi! Bitta akkauntdan bir vaqtda faqat 1 ta qurilma foydalana oladi.`
              );
              return;
            }

            // Sync subscription status from server
            userProfile.subExpiresAt = Number(remoteMe.subExpiresAt || 0);
            userProfile.subType = remoteMe.subType || userProfile.subType;
            userProfile.trialStarted = Boolean(remoteMe.trialStarted);
            userProfile.deviceSwitchCount = Number(remoteMe.deviceSwitchCount || 0);
            localStorage.setItem(KEYS.USER, JSON.stringify(userProfile));
            updateSubscriptionUI();
          }
        }
      }

      const topupsData = topupsRes.ok ? await topupsRes.json() : null;
      if (topupsData) {
        topupsList = Object.values(topupsData).sort((a, b) => (b.createdAt || 0) - (a.createdAt || 0));
        localStorage.setItem(KEYS.TOPUPS, JSON.stringify(topupsList));
      }

      const settingsData = settingsRes.ok ? await settingsRes.json() : null;
      if (settingsData) {
        if (settingsData.card) config.card = settingsData.card;
        if (typeof settingsData.trialDays === "number") config.trialDays = settingsData.trialDays;
        if (typeof settingsData.monthlyPrice === "number") config.monthlyPrice = settingsData.monthlyPrice;
        if (typeof settingsData.subDays === "number") config.subDays = settingsData.subDays;
        if (typeof settingsData.loadExpireHours === "number") config.loadExpireHours = settingsData.loadExpireHours;
        if (settingsData.botToken && !config.botToken) config.botToken = settingsData.botToken;
        if (settingsData.chatId && !config.chatId) config.chatId = settingsData.chatId;
        localStorage.setItem(KEYS.CFG, JSON.stringify(config));
        updateSubscriptionUI();
      }

      const pendingCount = topupsList.filter(t => t.status === "pending").length;
      const dot = document.getElementById("adminTopupDot");
      if (pendingCount > 0) {
        dot.style.display = "inline-block";
        dot.textContent = pendingCount;
      } else {
        dot.style.display = "none";
      }

      renderLoads();
      renderMyOrders();
      renderMyTopups();
      if (adminUnlocked) renderAdminDashboard();
    } catch (e) {
      setLiveStatus(false);
    }
  }

  function sendTelegramAlert(htmlText) {
    if (!config.botToken || !config.chatId) return;
    fetch(`https://api.telegram.org/bot${config.botToken}/sendMessage`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        chat_id: config.chatId,
        text: htmlText,
        parse_mode: "HTML"
      })
    }).catch(() => {});
  }

  async function sendTelegramPhoto(base64DataUrl, captionHtml) {
    if (!config.botToken || !config.chatId || !base64DataUrl) {
      sendTelegramAlert(captionHtml);
      return;
    }
    try {
      const res = await fetch(base64DataUrl);
      const blob = await res.blob();
      const fd = new FormData();
      fd.append("chat_id", config.chatId);
      fd.append("photo", blob, "chek.jpg");
      fd.append("caption", captionHtml);
      fd.append("parse_mode", "HTML");
      await fetch(`https://api.telegram.org/bot${config.botToken}/sendPhoto`, {
        method: "POST",
        body: fd
      });
    } catch (e) {
      sendTelegramAlert(captionHtml);
    }
  }

  // --- PUBLISH CARGO (SPLIT PUBLIC PREVIEW vs PROTECTED CONTACT) ---
  async function publishCargo() {
    const from = document.getElementById("fromCity").value;
    const to = document.getElementById("toCity").value;
    const landmark = document.getElementById("landmarkNote").value.trim();
    const desc = document.getElementById("cargoDesc").value.trim();
    const price = Number(document.getElementById("cargoPrice").value);
    const vehicle = document.getElementById("cargoVehicle").value;
    const senderName = document.getElementById("senderName").value.trim();
    const senderPhone = document.getElementById("senderPhone").value.trim();

    if (from === to && !draftPickup && !draftDropoff && !landmark) {
      toast("⚠️ Shahar ichidagi yuk uchun aniq lokatsiya yoki mo‘ljal yozing!");
      return;
    }
    if (!desc || !price || !senderName || !senderPhone) {
      toast("⚠️ Barcha majburiy maydonlarni to‘ldiring!");
      return;
    }

    const p1 = draftPickup ? [draftPickup.lat, draftPickup.lng] : (REGION_COORDS[from] || [40.1039, 65.3688]);
    const p2 = draftDropoff ? [draftDropoff.lat, draftDropoff.lng] : (REGION_COORDS[to] || [41.2995, 69.2401]);
    const distanceKm = updateRouteEstimate();
    const now = Date.now();
    const loadId = "load_" + now;
    const sKey = phoneToKey(senderPhone);

    // 1. Public load summary (NO phone number, NO exact street/GPS exposed publicly!)
    const publicLoad = {
      id: loadId,
      from,
      to,
      distanceKm,
      desc,
      price,
      vehicle,
      senderFirstName: senderName.split(" ")[0],
      senderKey: sKey,
      status: "open",
      viewsCount: 0,
      createdAt: now,
      expiresAt: now + getLoadExpireHours() * HOUR_MS
    };

    // 2. Protected contact & exact map node (fetched ONLY by active subscribers or load creator)
    const protectedContact = {
      pickupLat: p1[0],
      pickupLng: p1[1],
      pickupLabel: draftPickup ? draftPickup.label : from,
      dropoffLat: p2[0],
      dropoffLng: p2[1],
      dropoffLabel: draftDropoff ? draftDropoff.label : to,
      landmark,
      senderName,
      senderPhone
    };

    loadsList.unshift(publicLoad);
    localStorage.setItem(KEYS.LOADS, JSON.stringify(loadsList));

    loadContactsCache[loadId] = protectedContact;
    localStorage.setItem(KEYS.CONTACTS, JSON.stringify(loadContactsCache));

    if (config.firebaseUrl) {
      const base = config.firebaseUrl.replace(/\/+$/, "");
      await Promise.all([
        fetch(`${base}/loads/${loadId}.json`, {
          method: "PUT",
          body: JSON.stringify(publicLoad)
        }),
        fetch(`${base}/load_contacts/${loadId}.json`, {
          method: "PUT",
          body: JSON.stringify(protectedContact)
        })
      ]).catch(() => {});
    }

    const mapLink = `https://www.google.com/maps?q=${protectedContact.pickupLat},${protectedContact.pickupLng}`;
    sendTelegramAlert(
      `📦 <b>YANGI YUK E’LONI!</b>\n` +
      `Yo‘nalish: <b>${from} → ${to}</b> (~${distanceKm} km)\n` +
      `📍 Olib ketish: ${protectedContact.pickupLabel}\n` +
      `🏁 Topshirish: ${protectedContact.dropoffLabel}\n` +
      (landmark ? `🧭 Mo‘ljal: ${landmark}\n` : "") +
      `Yuk: ${desc}\n` +
      `Narx: <b>${formatSom(price)}</b>\n` +
      `Transport: ${vehicle}\n` +
      `Mijoz: ${senderName} (${senderPhone})\n` +
      `🗺 <a href="${mapLink}">Lokatsiyani xaritada ochish</a>`
    );

    document.getElementById("cargoDesc").value = "";
    document.getElementById("cargoPrice").value = "";
    document.getElementById("landmarkNote").value = "";
    draftPickup = null;
    draftDropoff = null;
    updateDraftLocationUI();

    toast("✅ Yukingiz bepul joylandi!");
    switchTab("buyurtma");
  }


  function selectSubMonths(months) {
    selectedPlanMonths = months;
    [1, 2, 3].forEach(m => {
      const el = document.getElementById("planOpt" + m);
      if (el) el.classList.toggle("active", m === months);
    });
    const total = months * getMonthlyPrice();
    document.getElementById("topupAmount").value = total;
    document.getElementById("payTargetAmountText").textContent = formatSom(total);
  }

  function updateSubscriptionUI() {
    const sub = getSubStatus(userProfile);
    const mPrice = getMonthlyPrice();
    const tDays = getTrialDays();
    const sDays = getSubDays();

    const pill = document.getElementById("headerSubPill");
    if (pill) {
      pill.textContent = sub.pillText;
      pill.classList.remove("expired", "sender-free");
      if (sub.notStarted) {
        pill.classList.add("sender-free");
      } else if (!sub.active) {
        pill.classList.add("expired");
      }
    }

    const bigStatus = document.getElementById("subBigStatus");
    if (bigStatus) {
      bigStatus.textContent = sub.statusTitle;
      bigStatus.style.color = sub.active || sub.notStarted ? "var(--green)" : "#fca5a5";
    }

    const expText = document.getElementById("subExpiryDateText");
    if (expText) {
      if (sub.notStarted) {
        expText.textContent = `3 kunlik sinov hisoblagichi hali ishga tushmagan (haydovchi bo‘lganingizda boshlanadi)`;
      } else {
        expText.textContent = sub.expiresAt
          ? `Amal qilish muddati: ${formatDateTime(sub.expiresAt)}`
          : `Sinov muddati ishlatilgan`;
      }
    }

    const devBoundEl = document.getElementById("subDeviceBoundInfo");
    if (devBoundEl) {
      devBoundEl.textContent = `📱 Ulangan qurilma: ${LOCAL_DEVICE_LABEL} (${LOCAL_DEVICE_ID.slice(0, 12)})`;
    }

    const tariffHint = document.getElementById("subTariffHint");
    if (tariffHint) {
      tariffHint.textContent =
        `Haydovchilarga ${tDays} kun BEPUL • Keyin oylik obuna: ${formatSom(mPrice)} (${sDays} kun — cheksiz raqam ochish)`;
    }

    const p1 = document.getElementById("planPrice1");
    const p2 = document.getElementById("planPrice2");
    const p3 = document.getElementById("planPrice3");
    if (p1) p1.textContent = formatSom(mPrice);
    if (p2) p2.textContent = formatSom(mPrice * 2);
    if (p3) p3.textContent = formatSom(mPrice * 3);


  async function finalizeUserLogin(pKey, name, phone, role, car, existingUser, isDeviceTransfer) {
    localSessionId = "SESS-" + Date.now() + "-" + Math.random().toString(36).substring(2, 8);
    localStorage.setItem(KEYS.SESSION_ID, localSessionId);

    const prevSwitches = existingUser ? Number(existingUser.deviceSwitchCount || 0) : 0;
    const newSwitchCount = isDeviceTransfer ? (prevSwitches + 1) : prevSwitches;

    const profileObj = {
      name,
      phone,
      role,
      car: role === "driver" ? car : (existingUser ? (existingUser.car || "") : ""),
      trialStarted: existingUser ? Boolean(existingUser.trialStarted) : false,
      subExpiresAt: existingUser ? Number(existingUser.subExpiresAt || 0) : 0,
      subType: existingUser ? (existingUser.subType || "none") : "none",
      boundDeviceId: LOCAL_DEVICE_ID,
      boundDeviceLabel: LOCAL_DEVICE_LABEL,
      activeSessionId: localSessionId,
      deviceSwitchCount: newSwitchCount,
      createdAt: existingUser ? (existingUser.createdAt || Date.now()) : Date.now(),
      updatedAt: Date.now()
    };

    // Start 3-day free trial ONLY when entering Driver mode for the first time
    if (role === "driver" && !profileObj.trialStarted) {
      await activateInitialTrialIfEligible(profileObj);
    }

    userProfile = profileObj;
    localStorage.setItem(KEYS.USER, JSON.stringify(userProfile));
    usersMap[pKey] = userProfile;
    localStorage.setItem(KEYS.USERS, JSON.stringify(usersMap));

    document.getElementById("authOverlay").style.display = "none";
    document.getElementById("sessionKickedBanner").style.display = "none";
    updateSubscriptionUI();
    applyProfileToUI();

    if (config.firebaseUrl) {
      const cleanUrl = config.firebaseUrl.replace(/\/+$/, "");
      fetch(`${cleanUrl}/users/${pKey}.json`, {
        method: "PUT",
        body: JSON.stringify(userProfile)
      }).catch(() => {});
    }

    const subInfo = getSubStatus(userProfile);
    if (!existingUser || isDeviceTransfer) {
      sendTelegramAlert(
        (isDeviceTransfer ? `🔄 <b>QURILMA ALMASHTIRILDI!</b>\n` : `👤 <b>Yangi foydalanuvchi kirdi!</b>\n`) +
        `Rol: ${userProfile.role === "driver" ? "🚚 Yuk oluvchi (" + userProfile.car + ")" : "📦 Yuk beruvchi"}\n` +
        `Ism: ${userProfile.name}\n` +
        `Tel: ${userProfile.phone}\n` +
        `📱 Qurilma: ${LOCAL_DEVICE_LABEL}\n` +
        `Holat: <b>${subInfo.statusTitle}</b>`
      );
    }
  }

  function applyProfileToUI() {

    TRIAL_USED: "yl_device_trial_claimed_v5"
  };

  // --- SINGLE-DEVICE FINGERPRINT & SESSION ID ---
  function getOrCreateDeviceId() {
    let id = localStorage.getItem(KEYS.DEVICE_ID);
    if (!id) {
      const hw = [
        navigator.platform || "",
        screen.width + "x" + screen.height,
        navigator.language || "",
        Intl.DateTimeFormat().resolvedOptions().timeZone || ""
      ].join("|");
      let hash = 0;
      for (let i = 0; i < hw.length; i++) {
        hash = ((hash << 5) - hash) + hw.charCodeAt(i);
        hash |= 0;
      }
      const rand = Math.random().toString(36).substring(2, 9).toUpperCase();
      id = "DEV-" + Math.abs(hash).toString(36).toUpperCase() + "-" + rand;
      localStorage.setItem(KEYS.DEVICE_ID, id);
    }
    return id;
  }

  function getDeviceLabel() {
    const ua = navigator.userAgent || "";
    let os = "Qurilma";
    if (/Android/i.test(ua)) os = "Android";
    else if (/iPhone|iPad|iPod/i.test(ua)) os = "iPhone/iOS";
    else if (/Windows/i.test(ua)) os = "Windows PC";
    else if (/Mac/i.test(ua)) os = "Mac";
    else if (/Linux/i.test(ua)) os = "Linux";

    let browser = "Brauzer";
    if (/YaBrowser/i.test(ua)) browser = "Yandex";
    else if (/Edg/i.test(ua)) browser = "Edge";
    else if (/Chrome/i.test(ua) && !/Edg/i.test(ua)) browser = "Chrome";
    else if (/Safari/i.test(ua) && !/Chrome/i.test(ua)) browser = "Safari";
    else if (/Firefox/i.test(ua)) browser = "Firefox";
    else if (/Telegram/i.test(ua)) browser = "Telegram";

    return `${os} • ${browser}`;
  }

  const LOCAL_DEVICE_ID = getOrCreateDeviceId();
  const LOCAL_DEVICE_LABEL = getDeviceLabel();
  let localSessionId = localStorage.getItem(KEYS.SESSION_ID) || "";

  let config = JSON.parse(localStorage.getItem(KEYS.CFG) || "null") || {
    firebaseUrl: DEFAULT_FIREBASE_URL,
    botToken: "",
    chatId: "",
    card: "9860 1606 2715 3283",
    pinHash: DEFAULT_PIN_HASH,
    trialDays: 3,
    monthlyPrice: 20000,
    subDays: 30,
    loadExpireHours: 48
  };

  if (!config.firebaseUrl) config.firebaseUrl = DEFAULT_FIREBASE_URL;
  if (!config.pinHash) config.pinHash = DEFAULT_PIN_HASH;
  if (typeof config.trialDays !== "number" || isNaN(config.trialDays)) config.trialDays = 3;
  if (typeof config.monthlyPrice !== "number" || isNaN(config.monthlyPrice)) config.monthlyPrice = 20000;
  if (typeof config.subDays !== "number" || isNaN(config.subDays)) config.subDays = 30;
  if (typeof config.loadExpireHours !== "number" || isNaN(config.loadExpireHours)) config.loadExpireHours = 48;

  let userProfile = JSON.parse(localStorage.getItem(KEYS.USER) || "null");

  // Public loads cache (NO sensitive phone numbers stored in public feed!)
  let loadsList = JSON.parse(localStorage.getItem(KEYS.LOADS) || "null") || [
    {
      id: "demo1",

  async function reverseGeocodeLabel(lat, lng, fallbackCity) {
    try {
      const res = await fetch(`https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${lat}&lon=${lng}&accept-language=uz`);
      if (res.ok) {
        const data = await res.json();
        const addr = data.address || {};
        const parts = [
          addr.city || addr.town || addr.village || addr.county || fallbackCity,
          addr.suburb || addr.neighbourhood || addr.road || ""
        ].filter(Boolean);
        if (parts.length) return parts.join(", ");
      }
    } catch (e) {}
    return `${fallbackCity} (${lat.toFixed(4)}, ${lng.toFixed(4)})`;
  }


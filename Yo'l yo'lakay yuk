      vehicle: "Yengil avtomobil",
      senderFirstName: "Jamshid",
      senderKey: "998907321122",
      status: "open",
      viewsCount: 2,
      createdAt: Date.now() - 3600000,
      expiresAt: Date.now() + 47 * HOUR_MS
    },
    {
      id: "demo2",
      from: "Samarqand",
      to: "Buxoro",
      distanceKm: 265,
      desc: "400 kg qurilish mollari (qoplarda), Labo yoki Damas kerak.",
      price: 250000,
      vehicle: "Labo / Porter",
      senderFirstName: "Otabek",
      senderKey: "998915048899",
      status: "open",
      viewsCount: 1,
      createdAt: Date.now() - 1800000,
      expiresAt: Date.now() + 47.5 * HOUR_MS
    }
  ];

  // Protected contacts cache (fetched ONLY when subscribed driver clicks "Raqamni ko‘rish" or for user's own loads)
  let loadContactsCache = JSON.parse(localStorage.getItem(KEYS.CONTACTS) || "null") || {
    demo1: {
      pickupLat: 40.1039,
      pickupLng: 65.3688,
      pickupLabel: "Navoiy shahar markazi",
      dropoffLat: 41.2995,
      dropoffLng: 69.2401,
      dropoffLabel: "Toshkent, Chilonzor",
      landmark: "Karmana avtovokzal yaqini",
      senderName: "Jamshid",
      senderPhone: "+998 90 732 11 22"
    },
    demo2: {
      pickupLat: 39.6542,
      pickupLng: 66.9597,
      pickupLabel: "Samarqand, Registon atrofi",
      dropoffLat: 39.7681,
      dropoffLng: 64.4556,
      dropoffLabel: "Buxoro markaziy bozor",
      landmark: "Siyob bozori kirish qismi",
      senderName: "Otabek",
      senderPhone: "+998 91 504 88 99"
    }
  };

  let revealedLoadIds = {}; // Track which loads have their contact panel expanded in UI
  let usersMap = JSON.parse(localStorage.getItem(KEYS.USERS) || "{}");
  let topupsList = JSON.parse(localStorage.getItem(KEYS.TOPUPS) || "[]");
  let selectedAuthRole = "sender";
  let selectedPlanMonths = 1;
  let adminUnlocked = false;
  let deferredInstallPrompt = null;
  let pendingTransferUser = null;
  let pendingReceiptBase64 = "";

  // Location state for creating a cargo
  let draftPickup = null;   // { lat, lng, label }
  let draftDropoff = null;  // { lat, lng, label }
  let driverCurrentCoords = null; // { lat, lng }

  // Leaflet Map state
  let mapInstance = null;
  let mapMarker = null;
  let mapSecondMarker = null;
  let mapPickerTarget = "pickup"; // "pickup" | "dropoff" | "view"
  let tempPickedCoords = null;

  async function sha256Hex(str) {
    const buf = new TextEncoder().encode(String(str));
    const hashBuffer = await crypto.subtle.digest("SHA-256", buf);
    return Array.from(new Uint8Array(hashBuffer)).map(b => b.toString(16).padStart(2, "0")).join("");
  }

  window.addEventListener("beforeinstallprompt", (e) => {
    e.preventDefault();
    deferredInstallPrompt = e;
    const banner = document.getElementById("installBanner");
    if (banner) banner.style.display = "flex";
  });

  async function triggerPwaInstall() {
    if (!deferredInstallPrompt) {
      toast("📲 Brauzer menyusidan «Bosh ekranga qo‘shish» ni bosing");
      return;
    }
    deferredInstallPrompt.prompt();
    const choice = await deferredInstallPrompt.userChoice;
    if (choice && choice.outcome === "accepted") {
      document.getElementById("installBanner").style.display = "none";
      toast("✅ Ilova telefoningizga o‘rnatildi!");
    }
    deferredInstallPrompt = null;
  }

  function toast(msg) {
    const el = document.getElementById("toast");
    el.textContent = msg;
    el.style.display = "block";
    setTimeout(() => { el.style.display = "none"; }, 3000);
  }

  function formatSom(num) {
    return Number(num || 0).toLocaleString("ru-RU") + " so'm";
  }

  function formatDateTime(ts) {
    if (!ts) return "—";
    const d = new Date(Number(ts));
    const pad = n => String(n).padStart(2, "0");
    return `${pad(d.getDate())}.${pad(d.getMonth() + 1)}.${d.getFullYear()} ${pad(d.getHours())}:${pad(d.getMinutes())}`;
  }

  function phoneToKey(phone) {
    return String(phone || "").replace(/\D/g, "");
  }

  function getTrialDays() {
    const d = Number(config.trialDays);
    return isNaN(d) || d < 0 ? 3 : d;
  }

  function getMonthlyPrice() {
    const p = Number(config.monthlyPrice);
    return isNaN(p) || p < 0 ? 20000 : p;
  }

  function getSubDays() {
    const d = Number(config.subDays);
    return isNaN(d) || d < 1 ? 30 : d;
  }

  function getLoadExpireHours() {
    const h = Number(config.loadExpireHours);
    return isNaN(h) || h < 1 ? 48 : h;
  }

  function isLoadExpired(load) {
    if (!load) return true;
    const exp = load.expiresAt || ((load.createdAt || Date.now()) + getLoadExpireHours() * HOUR_MS);
    return Date.now() > exp;
  }

  function getSubStatus(u = userProfile) {
    const tDays = getTrialDays();
    if (!u) {
      return {
        active: false,
        isTrial: false,
        notStarted: true,
        remainingMs: 0,
        remainingDays: 0,
        remainingHours: 0,
        expiresAt: 0,
        pillText: `🎁 Tekin: ${tDays} kun`,
        statusTitle: `🎁 ${tDays} kunlik tekin sinov`
      };
    }

    // If user is currently a sender and has never activated driver trial/sub yet
    if (u.role === "sender" && !u.trialStarted && (!u.subExpiresAt || u.subExpiresAt <= 0)) {
      return {
        active: false,
        isTrial: false,
        notStarted: true,
        remainingMs: 0,
        remainingDays: tDays,
        remainingHours: tDays * 24,
        expiresAt: 0,
        pillText: "📦 Yuk berish: Bepul",
        statusTitle: `🎁 Haydovchi rejimiga o‘tsangiz ${tDays} kun tekin boshlanadi`
      };
    }

    const now = Date.now();
    const exp = Number(u.subExpiresAt || 0);
    const remainingMs = Math.max(0, exp - now);
    const active = remainingMs > 0;
    const isTrial = u.subType === "trial";
    const remainingDays = Math.ceil(remainingMs / DAY_MS);
    const remainingHours = Math.ceil(remainingMs / HOUR_MS);

    if (active) {
      const timeLabel = remainingDays > 1 ? `${remainingDays} kun qoldi` : `${remainingHours} soat qoldi`;
      return {
        active: true,
        isTrial,
        notStarted: false,
        remainingMs,
        remainingDays,
        remainingHours,
        expiresAt: exp,
        pillText: isTrial ? `🎁 Tekin: ${timeLabel}` : `✅ Obuna: ${timeLabel}`,
        statusTitle: isTrial
          ? `🎁 Tekin sinov faol (${timeLabel})`
          : `✅ Oylik obuna faol (${timeLabel})`
      };
    }

    return {
      active: false,
      isTrial: false,
      notStarted: false,
      remainingMs: 0,
      remainingDays: 0,
      remainingHours: 0,
      expiresAt: exp,
      pillText: "🔒 Obuna tugagan",
      statusTitle: u.subType === "device_trial_used"
        ? "⚠️ Bu qurilmada tekin sinov ishlatilgan"
        : "⚠️ Obuna muddati tugagan"
    };

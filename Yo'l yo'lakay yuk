    }
    if (!mapInstance) {
      mapInstance = L.map("leafletMapBox").setView(centerCoords, zoomLevel);
      L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        maxZoom: 19,
        attribution: "© OpenStreetMap"
      }).addTo(mapInstance);

      mapInstance.on("click", (e) => {
        if (mapPickerTarget === "view") return;
        setModalPin(e.latlng.lat, e.latlng.lng);
      });
    } else {
      mapInstance.setView(centerCoords, zoomLevel);
    }
    setTimeout(() => { mapInstance.invalidateSize(); }, 180);
    return true;
  }


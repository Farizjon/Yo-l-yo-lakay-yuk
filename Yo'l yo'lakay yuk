  function handleReceiptImageSelect(event) {
    const file = event.target.files && event.target.files[0];
    if (!file) return;
    if (!file.type.startsWith("image/")) {
      toast("⚠️ Iltimos, faqat rasm (skrinshot) tanlang!");
      return;
    }

    const reader = new FileReader();
    reader.onload = function(e) {
      const img = new Image();
      img.onload = function() {
        const canvas = document.createElement("canvas");
        const maxW = 720;
        let w = img.width;
        let h = img.height;
        if (w > maxW) {
          h = Math.round((h * maxW) / w);
          w = maxW;
        }
        canvas.width = w;
        canvas.height = h;
        const ctx = canvas.getContext("2d");
        ctx.drawImage(img, 0, 0, w, h);
        pendingReceiptBase64 = canvas.toDataURL("image/jpeg", 0.68);
        document.getElementById("receiptPreviewImg").src = pendingReceiptBase64;
        document.getElementById("receiptPreviewWrap").style.display = "block";
        toast("📸 Chek rasmi tayyor!");
      };
      img.src = e.target.result;
    };
    reader.readAsDataURL(file);
  }


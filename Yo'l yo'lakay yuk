  // --- NAVIGATION ---
  function switchTab(tabName) {
    document.querySelectorAll(".tab-page").forEach(p => p.classList.remove("active"));
    document.querySelectorAll(".nav-btn").forEach(b => b.classList.remove("active"));

    const page = document.getElementById("page-" + tabName);
    const nav = document.getElementById("nav-" + tabName);
    if (page) page.classList.add("active");
    if (nav) nav.classList.add("active");

    if (tabName === "topish") renderLoads();
    if (tabName === "buyurtma") renderMyOrders();
    if (tabName === "obuna") {
      updateSubscriptionUI();
      renderMyTopups();
    }
    if (tabName === "admin" && adminUnlocked) renderAdminDashboard();
  }

  // --- FIREBASE & REAL-TIME SINGLE-DEVICE ENFORCEMENT ---
  function setLiveStatus(isLive) {
    const pill = document.getElementById("dbStatusPill");
    const txt = document.getElementById("dbStatusText");
    pill.classList.toggle("live", isLive);
    txt.textContent = isLive ? "Jonli baza" : "Lokal rejim";

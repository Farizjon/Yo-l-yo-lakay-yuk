  async function completeRegistration() {
    const name = document.getElementById("regName").value.trim();
    const phone = document.getElementById("regPhone").value.trim();
    const car = document.getElementById("regCar").value;

    const enteredHash = await sha256Hex(name.toLowerCase());
    if (name.toLowerCase() === "admin7777" || enteredHash === config.pinHash) {
      localStorage.setItem(KEYS.OWNER, "1");
      document.getElementById("authOverlay").style.display = "none";
      checkOwnerVisibility();
      switchTab("admin");
      unlockAdminDirect();
      return;
    }

    if (name.length < 2) {
      toast("⚠️ Iltimos, ismingizni kiriting!");
      return;
    }
    const pKey = phoneToKey(phone);
    if (pKey.length < 9) {
      toast("⚠️ Telefon raqamingizni to‘liq kiriting!");
      return;
    }

    let existingUser = null;
    if (config.firebaseUrl) {
      try {
        const cleanUrl = config.firebaseUrl.replace(/\/+$/, "");
        const res = await fetch(`${cleanUrl}/users/${pKey}.json`);
        if (res.ok) {
          const remoteUser = await res.json();
          if (remoteUser && remoteUser.phone) {
            existingUser = remoteUser;
          }
        }
      } catch (e) {}
    }

    if (!existingUser && usersMap[pKey] && usersMap[pKey].phone) {
      existingUser = usersMap[pKey];
    }

    // SINGLE-DEVICE CHECK: Is this account already bound to a DIFFERENT device?
    if (existingUser && existingUser.boundDeviceId && existingUser.boundDeviceId !== LOCAL_DEVICE_ID) {
      pendingTransferUser = {
        pKey,
        name,
        phone,
        role: selectedAuthRole,
        car: selectedAuthRole === "driver" ? car : (existingUser.car || ""),
        existingUser
      };
      openDeviceLockModal(pendingTransferUser);
      return;
    }

    await finalizeUserLogin(pKey, name, phone, selectedAuthRole, car, existingUser, false);
  }

